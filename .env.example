# ==============================================================================
# C.L.E.A.R. Environment Variables Example Template
# Rename this file to .env and configure the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Connection (Required)
# ------------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma ORM and the Express backend pool.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name?sslmode=require"

# ------------------------------------------------------------------------------
# Server Configuration (Optional)
# ------------------------------------------------------------------------------
# The port the backend Express server will listen on. Defaults to 3000.
PORT=3000

# ------------------------------------------------------------------------------
# Authentication (Required for Production Security)
# ------------------------------------------------------------------------------
# Secret key used for signing JWT tokens. Run one of the commands below to generate.
# Ensure you do NOT use the development defaults in production.
JWT_SECRET="your-secure-random-jwt-secret-placeholder"

# Pre-shared security token required for municipal officers to register.
# Municipal officers must specify this key when signing up.
MUNICIPAL_AUTH_KEY="your-secure-municipal-auth-key-placeholder"
