{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://clear-backend-production-url.up.railway.app/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://clear-backend-production-url.up.railway.app/media/:path*"
    },
    {
      "source": "/((?!api|media|favicon|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
